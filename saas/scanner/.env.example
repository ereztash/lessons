# PortfolioPilot Scanner — environment configuration
# Copy this file to `.env` (which is gitignored) and fill in real values.

# A GitHub Personal Access Token (classic) or fine-grained PAT.
# Required scopes (classic):
#   - repo            (read private + public repo metadata, commits, PRs, issues, contents)
#   - read:user       (read your username + basic profile)
# Create one here: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_replace_with_real_token

# The username whose repos should be scanned. For self-scanning, this is YOUR
# GitHub username (the same one the token belongs to).
GITHUB_USERNAME=ereztash

# Where to drop generated reports. Relative paths resolve from the scanner's
# working directory. Default if unset: ./output
OUTPUT_DIR=./output
